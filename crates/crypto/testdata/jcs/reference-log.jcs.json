f9f","sampledPages":[],"scope":"STICHPROBE","sheetCount":52,"textId":"SCAN-DECL-DE#VOLLSTAENDIGKEIT","textVersion":"1.0"},"kind":"VOLLSTAENDIGKEIT","note":null,"pagesDisplayed":null,"result":"BESTAETIGT","signature":null,"subject":null},{"acr":null,"atDevice":"2026-09-02T14:32:18Z","atSource":"SERVER_ANKER","atTrusted":null,"authenticatorClass":null,"coversHash":"2b8c04965678895201a8c9a196869dbb8b65c728fc6453bd7209761fe301116c","declaration":{"actualSheetCount":null,"deviationSheets":null,"expectedSheetCount":null,"locale":"de-DE","mismatchJustification":null,"pageCount":104,"renderedText":"Ich habe eine Stichprobe von 11 der 104 Seiten am Bildschirm angesehen — die Seiten 3, 9, 14, 22, 27, 38, 51, 66, 79, 88 und 104. Für diese Seiten stimmt die Wiedergabe mit dem Papieroriginal bildlich und inhaltlich überein: Texte, Zahlen, Stempel, Unterschriften und farbige Vermerke sind vollständig und lesbar wiedergegeben. Für die übrigen Seiten stütze ich mich auf den Blattzahl-Abgleich (52 Blatt erwartet, 52 Blatt eingezogen) und auf die Doppeleinzugserkennung des Geräts. Eine vollständige Sichtprüfung habe ich nicht vorgenommen.","renderedTextHash":"be78b6e33f59b990c7e57c4fcef1362717e23628509ff8e37b69c42a76aebe05","sampledPages":[3,9,14,22,27,38,51,66,79,88,104],"scope":"STICHPROBE","sheetCount":52,"textId":"SCAN-DECL-DE#UEBEREINSTIMMUNG","textVersion":"1.0"},"kind":"UEBEREINSTIMMUNG","note":null,"pagesDisplayed":null,"result":"BESTAETIGT","signature":null,"subject":null}],"clientBehauptet":{"adbEnabled":null,"deviceOwner":null,"deviceWallClockAtDeclaration":null,"disclaimer":"Vom Erfassungsgeraet behauptet, nicht unabhaengig festgestellt.","expectedSheetCount":4,"fullViewOpenCounts":{},"pagesDisplayed":[],"physicalFeeds":4,"scrolledToEnd":null},"completeness":{"actualSheetCount":4,"correction":null,"duplicateCheckPerformed":false,"duplicateCheckResult":null,"expectedSheetCount":{"quelle":"BEDIENER_EINGABE","wert":4},"expectedSheetCountSource":"OPERATOR_BEFORE_FEED","method